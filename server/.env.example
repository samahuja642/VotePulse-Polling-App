# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/votepulse

# JWT — generate strong secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated for multiple origins (e.g. Vercel preview + production)
# Production example: https://votepulse.vercel.app,https://votepulse.yourdomain.com
CLIENT_ORIGIN=http://localhost:5173

# Cookie
COOKIE_SECRET=your_cookie_secret_min_32_chars

# Cloudflare Turnstile (optional — leave empty to disable)
TURNSTILE_SECRET_KEY=
